# InstaVision-Relay - copy to .env and fill in the three values at the top.
# Everything here is optional except the account and the Firebase key. Keep the
# filled-in .env out of git: it holds the password of a real account.

# --- the account the relay signs in as -------------------------------------
INSTAVISION_EMAIL=you@example.com
INSTAVISION_PASSWORD=
# Firebase Web API key of the vendor's project. This is a public client key (it
# ships inside the app's own bundle), not a secret.
INSTAVISION_FIREBASE_KEY=

# --- what to publish --------------------------------------------------------
# Comma-separated camera names. EMPTY PUBLISHES NOTHING.
# The gateway keeps its own list in state/enrolled.json, so this is only used by
# the headless relay profile.
INSTAVISION_ENROLLED=

# --- vendor endpoints - change only if the vendor moves them ----------------
INSTAVISION_PARTNER=instaview
INSTAVISION_CLIENT_ID=home-user-portal
INSTAVISION_API=https://api-us.instavision.ai/
INSTAVISION_KVS_REGION=us-west-2

# --- ports ------------------------------------------------------------------
INSTAVISION_RTSP_BASE=rtsp://127.0.0.1:8574
INSTAVISION_UI_PORT=8665
INSTAVISION_UI_BIND=0.0.0.0
INSTAVISION_RELAY_STATUS_PORT=8656
INSTAVISION_HTTP_PORT=8655

# --- sessions ---------------------------------------------------------------
# How long one viewer session runs before it is rebuilt with fresh credentials.
INSTAVISION_SESSION_SECONDS=3600
# How long the gateway holds an unanswered offer; the cameras publish only now
# and then, so this is long on purpose.
INSTAVISION_GATEWAY_ANSWER_TIMEOUT=600
INSTAVISION_DEVICE_TTL=60
INSTAVISION_SNAPSHOT_TTL=30

# --- the user the container runs as (must own ./state) ----------------------
INSTAVISION_UID=1000
INSTAVISION_GID=1000
