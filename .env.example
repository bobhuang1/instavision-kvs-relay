# Copy to .env and fill in. .env is gitignored - never commit real values.

# Account credentials for the camera app. Authenticating this way signs in as you
# would on the phone; use an account you are willing to have a service sign in as.
INSTAVISION_EMAIL=''
INSTAVISION_PASSWORD=''

# The vendor's API needs to be told which client and partner is calling. These are
# the values the vendor's own web client ships with, read out of its JavaScript
# bundle; they are not secrets.
INSTAVISION_PARTNER='instaview'
INSTAVISION_CLIENT_ID='home-user-portal'
INSTAVISION_API='https://api-us.instavision.ai/'

# Firebase Web API key for the vendor's project. Also not a secret: it ships in
# every copy of the app and of their web client.
INSTAVISION_FIREBASE_KEY=''

# Region reported by the credential response. Only a fallback: the response carries
# the real region and that is what gets used.
INSTAVISION_KVS_REGION='us-west-2'

# --- relay settings ---------------------------------------------------------
# Comma-separated camera names to publish. EMPTY PUBLISHES NOTHING, which is the
# safe default: an enrolled camera streams continuously and uses uplink.
INSTAVISION_ENROLLED=''

# How long one viewer session runs before it is rebuilt with fresh credentials.
INSTAVISION_SESSION_SECONDS=3600

# How long to wait for a camera to answer the SDP offer before giving up. Kept
# short so a camera that comes online is picked up quickly.
INSTAVISION_ANSWER_TIMEOUT=25

# Status/health JSON for a watchdog. 200 when every enrolled camera is streaming.
INSTAVISION_HTTP_PORT=8655
INSTAVISION_HTTP_BIND=0.0.0.0
